{
  "entryPointStrategy": "expand",
  "entryPoints": ["./src"],
  "exclude": [
    "**/*.spec.ts*",
    "**/*.spec-d.ts*",
    "**/*.test.ts*",
    "**/*.test-d.ts*",
    "src/util/unit-test.ts",
    "src/config/environment.ts"
  ],
  "tsconfig": "tsconfig.build.json",
  "out": "docs",
  "plugin": ["typedoc-plugin-markdown"]
}
